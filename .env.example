# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Required ---------------------------------------------------------------

# Telegram bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN_PSYCHO=your-telegram-bot-token

# OpenAI API key — powers BOTH the LLM analysis/report and Whisper speech-to-text.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Your Telegram numeric chat id (the owner). Multiple ids may be comma-separated.
# Ask @userinfobot for yours.
TELEGRAM_CHAT_ID=000000000

# --- Optional ---------------------------------------------------------------

# Redis connection URL for the 7-day journal ledger. Defaults to localhost.
REDIS_URL=redis://localhost:6379

# Model overrides (sensible defaults are built in; set only to override).
# Weekly report uses a stronger model; on-demand analysis uses a cheaper/faster one.
# PSYCHO_REPORT_MODEL=gpt-5.5
# PSYCHO_ANALYSIS_MODEL=gpt-5.4-mini

# Run the weekly report inside the long-poll process instead of via a systemd
# timer (see deploy/). Off by default; set to 1 on hosts without systemd timers.
# PSYCHO_INPROC_REPORT=0
